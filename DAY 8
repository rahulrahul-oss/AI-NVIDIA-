import os
import requests
from PIL import Image
import io
from IPython.display import display
import torch
from diffusers import DiffusionPipeline
from dotenv import load_dotenv

# Load environment variables from .env file
load_dotenv()

# Handle environment compatibility (Colab vs local Jupyter)
try:
    from google.colab import userdata
    HF_TOKEN = userdata.get('HF_TOKEN')
except ImportError:
    HF_TOKEN = os.environ.get('HF_TOKEN')

# If token is not set, prompt the user for it
if not HF_TOKEN:
    import getpass
    HF_TOKEN = getpass.getpass("Enter your Hugging Face Token: ")

pipe_ideogram = None

# Load the model directly from HuggingFace Hub
try:
    pipe_ideogram = DiffusionPipeline.from_pretrained(
        "ideogram-ai/ideogram-4-fp8",
        torch_dtype=torch.float16,
        use_safetensors=True,
        token=HF_TOKEN,
        variant="fp16",
    )
    # Move model to GPU if cuda is available
    if torch.cuda.is_available():
        pipe_ideogram.to("cuda")
        print("Ideogram-4 model loaded successfully on GPU for local generation.")
    else:
        pipe_ideogram.to("cpu")
        print("Ideogram-4 model loaded successfully on CPU for local generation.")
except Exception as e:
    print(f"Failed to load Ideogram-4 model locally: {e}")
    print("Falling back to HuggingFace Inference API (using huggingface_hub.InferenceClient with the new router endpoint).")

def generate_image_ideogram(prompt, filename=None):
    print(f'Generating with Ideogram-4: {prompt}')
    if pipe_ideogram:
        images = pipe_ideogram(prompt, num_inference_steps=25).images
        image = images[0]
        display(image)  # Show inline
        if filename:
            image.save(filename)
            print(f'Saved as {filename}')
        return image
    else:
        from huggingface_hub import InferenceClient
        try:
            # Using the new Hugging Face API Router URL directly to bypass deprecated api-inference domain
            client = InferenceClient(
                model="https://router.huggingface.co/hf-inference/models/black-forest-labs/FLUX.1-schnell",
                token=HF_TOKEN
            )
            image = client.text_to_image(prompt)
            display(image)  # Show inline
            if filename:
                image.save(filename)
                print(f'Saved as {filename}')
            return image
        except Exception as e:
            print(f'HuggingFace Inference Error: {e}')
            print("Image generation aborted.")
            return None

