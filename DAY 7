# Chat Loop
while True:

    user = input("\nYou : ").lower()

    if user == "exit":
        print("Bot : Goodbye!")
        break

    # Tokenization
    tokens = word_tokenize(user)

    found = False

    # Keyword Matching
    for word in tokens:

        if word in responses:
            print("Bot :", random.choice(responses[word]))
            found = True
            break

    if not found:
        print("Bot : Sorry, I don't understand. Please ask another question.")
